# =============================================================================
# apps/web — Revenue War Room operator UI
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development (`.env*` is gitignored). These are
# the only variables the web app reads. No secrets are required to run the
# deterministic golden-path demo.
# =============================================================================

# Which backing the /api/agent/* route handlers use:
#   mock  → return the deterministic golden_path_v1 response (default)
#   live  → proxy to the real agent API at API_BASE_URL
AGENT_API_MODE=mock

# Base URL of the live agent API (only used when AGENT_API_MODE=live).
API_BASE_URL=http://localhost:8787
