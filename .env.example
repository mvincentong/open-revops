# =============================================================================
# OpenRevOps — example environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. This file documents the
# variables the project reads; it contains NO real secrets. Use TEST/SANDBOX
# keys only for local development and demos.
# =============================================================================

# ----- Core -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Public base URL of the web app (operator UI).
APP_BASE_URL=http://localhost:3000
# API base URL (agent runtime / orchestration).
API_BASE_URL=http://localhost:8787

# ----- LLM / Agent runtime --------------------------------------------------
# The agent decision engine is provider-agnostic. Supply ONE provider.
# Anthropic (recommended default for agentic planning):
ANTHROPIC_API_KEY=
# Optional: route via Vercel AI Gateway instead of a direct provider key.
AI_GATEWAY_API_KEY=
# Default model id used by the agent (override per-deployment).
AGENT_MODEL=claude-sonnet-4-6

# ----- Stripe (ACTIONS) — use TEST mode keys only for the demo ---------------
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret (Stripe CLI: `stripe listen --forward-to ...`).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- Exa (RESEARCH / context) ---------------------------------------------
# https://exa.ai/  → API keys. Required ONLY in live mode. Replay mode (the
# default) needs no key and reads a committed synthetic fixture, so the
# golden-path demo stays deterministic. Placeholder only — never a real key.
EXA_API_KEY=<YOUR_EXA_API_KEY>
# Connector mode: "replay" (default, deterministic) or "live" (calls the Exa API).
EXA_MODE=replay

# ----- Storage / event store -------------------------------------------------
# Default local demo uses an embedded store; override for cloud.
DATABASE_URL=
# Append-only audit log destination (defaults to local file in dev).
AUDIT_LOG_URL=

# ----- Guardrails / policy ---------------------------------------------------
# Operations above this confidence may auto-execute IF the guardrail matrix
# allows it; everything else requires human approval. (See docs/policy-rules.md)
POLICY_AUTO_EXECUTE_CONFIDENCE=0.95
# Hard kill-switch: when true, NO action ever auto-executes (approval always).
POLICY_REQUIRE_APPROVAL_ALWAYS=true

# ----- Demo determinism ------------------------------------------------------
# Fixed seed so the golden-path demo produces identical output every run.
DEMO_SEED=open-revops-golden-v1
